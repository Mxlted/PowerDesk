<UserControl x:Class="PowerDesk.Modules.DnsDesk.Views.DnsDeskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource SurfaceBaseBrush}"
             Foreground="{DynamicResource TextPrimaryBrush}">
    <UserControl.Resources>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="MonoCellText" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Style="{StaticResource TextDisplay}" Text="DnsDesk"/>
                <TextBlock Style="{StaticResource TextCaption}" Margin="0,4,0,0"
                           Text="View adapters, switch DNS profiles, and flush the resolver cache."/>
                <Border Style="{StaticResource Pill}" Margin="0,8,0,0"
                        Visibility="{Binding IsAdmin, Converter={StaticResource InverseBoolToVis}}">
                    <TextBlock Style="{StaticResource TextCaption}" Foreground="{DynamicResource WarningBrush}"
                               Text="Administrator required to change DNS servers"/>
                </Border>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Flush DNS" Command="{Binding FlushDnsCommand}"
                        ToolTip="Clear the local DNS resolver cache (ipconfig /flushdns). No administrator rights needed."/>
                <Button Content="Relaunch as administrator" Margin="8,0,0,0"
                        Command="{Binding RelaunchAsAdminCommand}"
                        ToolTip="Restart PowerDesk elevated so DNS servers can be changed."
                        Visibility="{Binding IsAdmin, Converter={StaticResource InverseBoolToVis}}"/>
                <Button Content="Refresh" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Command="{Binding RefreshCommand}"
                        ToolTip="Re-scan network adapters (F5)"/>
            </StackPanel>
        </DockPanel>

        <WrapPanel Grid.Row="1" Margin="0,16,0,4">
            <Border Style="{StaticResource Card}" MinWidth="160" Margin="0,0,12,12">
                <StackPanel>
                    <TextBlock Text="Adapters" Style="{StaticResource TextCaption}"/>
                    <TextBlock Text="{Binding AdapterCount}" Style="{StaticResource TextTitle}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" MinWidth="160" Margin="0,0,12,12">
                <StackPanel>
                    <TextBlock Text="Online" Style="{StaticResource TextCaption}"/>
                    <TextBlock Text="{Binding OnlineCount}" Style="{StaticResource TextTitle}" Foreground="{DynamicResource SuccessBrush}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" MinWidth="200" Margin="0,0,12,12">
                <StackPanel>
                    <TextBlock Text="Last refresh" Style="{StaticResource TextCaption}"/>
                    <TextBlock Style="{StaticResource TextTitle}" FontSize="16"
                               Text="{Binding LastRefresh, StringFormat={}{0:HH:mm:ss}, TargetNullValue=Never}"/>
                </StackPanel>
            </Border>
        </WrapPanel>

        <ProgressBar Grid.Row="2" IsIndeterminate="True" Height="3" Margin="0,0,0,12"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="320"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <DataGrid ItemsSource="{Binding Adapters}" SelectedItem="{Binding SelectedAdapter}" IsReadOnly="True"
                              SelectionMode="Single" AutomationProperties.Name="Network adapters">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Adapter" Binding="{Binding Name}" Width="*" MinWidth="140"
                                                ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusLabel}" Width="90"
                                                ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding TypeLabel}" Width="120"
                                                ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="IPv4 DNS" Binding="{Binding Ipv4DnsServers}" Width="180"
                                                ElementStyle="{StaticResource MonoCellText}"/>
                            <DataGridTextColumn Header="IPv6 DNS" Binding="{Binding Ipv6DnsServers}" Width="220"
                                                ElementStyle="{StaticResource MonoCellText}"/>
                            <DataGridTextColumn Header="IPv6" Binding="{Binding Ipv6StatusLabel}" Width="100"
                                                ElementStyle="{StaticResource CellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                                Visibility="{Binding HasAdapters, Converter={StaticResource InverseBoolToVis}}">
                        <TextBlock Text="No network adapters found" Style="{StaticResource TextSubtitle}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Style="{StaticResource TextCaption}" HorizontalAlignment="Center" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="Loopback and tunnel interfaces are hidden. Press Refresh to scan again."/>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1" Margin="16,0,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Profile" Style="{StaticResource TextSubtitle}"/>
                    <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" Margin="0,10,0,0"
                              AutomationProperties.Name="DNS profile"/>
                    <TextBlock Text="{Binding SelectedProfile.ServerLabel}" Foreground="{DynamicResource TextSecondaryBrush}"
                               FontFamily="Consolas" Margin="0,8,0,0" TextWrapping="Wrap"/>

                    <StackPanel Visibility="{Binding IsCustomProfile, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                        <StackPanel.Resources>
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Setter Property="FontFamily" Value="Consolas"/>
                                <Setter Property="Margin" Value="0,4,0,0"/>
                            </Style>
                        </StackPanel.Resources>
                        <TextBlock Text="IPv4 primary" Style="{StaticResource TextCaption}" Margin="0,6,0,0"/>
                        <TextBox Text="{Binding CustomIpv4Primary, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Custom IPv4 primary DNS" ToolTip="e.g. 1.1.1.1">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding ApplyProfileCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Text="IPv4 secondary (optional)" Style="{StaticResource TextCaption}" Margin="0,8,0,0"/>
                        <TextBox Text="{Binding CustomIpv4Secondary, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Custom IPv4 secondary DNS" ToolTip="e.g. 1.0.0.1">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding ApplyProfileCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Text="IPv6 primary (optional)" Style="{StaticResource TextCaption}" Margin="0,8,0,0"/>
                        <TextBox Text="{Binding CustomIpv6Primary, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Custom IPv6 primary DNS" ToolTip="e.g. 2606:4700:4700::1111">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding ApplyProfileCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Text="IPv6 secondary (optional)" Style="{StaticResource TextCaption}" Margin="0,8,0,0"/>
                        <TextBox Text="{Binding CustomIpv6Secondary, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Custom IPv6 secondary DNS" ToolTip="e.g. 2606:4700:4700::1001">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding ApplyProfileCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                    </StackPanel>

                    <Button Content="Apply to selected adapter" Style="{StaticResource PrimaryButton}" Margin="0,14,0,0"
                            Command="{Binding ApplyProfileCommand}"
                            ToolTip="Write the profile's DNS servers to the selected adapter with netsh. IPv6 is skipped when the adapter has no usable IPv6 route."/>
                    <TextBlock Style="{StaticResource TextCaption}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="Changes apply immediately and can be reverted with the Automatic (DHCP) profile."/>

                    <Border Background="{DynamicResource DividerBrush}" Height="1" Margin="0,18"/>

                    <TextBlock Text="Select an adapter to see its details" Style="{StaticResource TextBody}"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,0"
                               Visibility="{Binding SelectedAdapter, Converter={StaticResource NullToVis}, ConverterParameter=invert}"/>

                    <StackPanel DataContext="{Binding SelectedAdapter}" Visibility="{Binding Converter={StaticResource NullToVis}}">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource TextSubtitle}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Border Style="{StaticResource Pill}">
                                <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource TextCaption}"/>
                            </Border>
                            <Border Style="{StaticResource Pill}" Margin="6,0,0,0">
                                <TextBlock Text="{Binding TypeLabel}" Style="{StaticResource TextCaption}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="IPv4 DNS" Style="{StaticResource TextCaption}" Margin="0,14,0,0"/>
                        <TextBlock Text="{Binding Ipv4DnsServers}" FontFamily="Consolas" TextWrapping="Wrap"/>
                        <TextBlock Text="IPv6 DNS" Style="{StaticResource TextCaption}" Margin="0,14,0,0"/>
                        <TextBlock Text="{Binding Ipv6DnsServers}" FontFamily="Consolas" TextWrapping="Wrap"/>
                        <TextBlock Text="IPv6 status" Style="{StaticResource TextCaption}" Margin="0,14,0,0"/>
                        <TextBlock Text="{Binding Ipv6StatusLabel}"/>
                        <TextBlock Text="Gateways" Style="{StaticResource TextCaption}" Margin="0,14,0,0"/>
                        <TextBlock Text="{Binding GatewayAddresses}" FontFamily="Consolas" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
    </UserControl.InputBindings>
</UserControl>
