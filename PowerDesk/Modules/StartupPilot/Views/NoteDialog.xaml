<Window x:Class="PowerDesk.Modules.StartupPilot.Views.NoteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit note"
        Background="{DynamicResource SurfaceBaseBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height"
        Width="480"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="{StaticResource AppFont}"
        FontSize="{StaticResource FontSizeBody}"
        FocusManager.FocusedElement="{Binding ElementName=NoteInput}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" x:Name="HeaderLabel" Style="{StaticResource TextSubtitle}" TextTrimming="CharacterEllipsis"/>
        <TextBox Grid.Row="1" x:Name="NoteInput" AcceptsReturn="True" TextWrapping="Wrap"
                 MinHeight="120" MaxHeight="260" Margin="0,12,0,0"
                 VerticalScrollBarVisibility="Auto"
                 AutomationProperties.Name="Note text"
                 PreviewKeyDown="NoteInput_PreviewKeyDown"/>
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource TextCaption}" VerticalAlignment="Center"
                       Text="Ctrl+Enter saves, Esc cancels. Leave empty to remove the note."/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="Cancel_Click" IsCancel="True"/>
                <Button Content="Save" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
