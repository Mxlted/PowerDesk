<UserControl x:Class="PowerDesk.Modules.StartupPilot.Views.StartupPilotView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:PowerDesk.Modules.StartupPilot.Models"
             Background="{DynamicResource SurfaceBaseBrush}"
             Foreground="{DynamicResource TextPrimaryBrush}">
    <UserControl.Resources>
        <!-- Cell text that trims instead of clipping and shows the full value on hover. -->
        <Style x:Key="TrimCell" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>
        <Style x:Key="MonoCell" TargetType="TextBlock" BasedOn="{StaticResource TrimCell}">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RescanCommand}"/>
    </UserControl.InputBindings>
    <Grid Margin="32,24" AllowDrop="True" PreviewDragOver="Root_PreviewDragOver" PreviewDrop="Root_PreviewDrop" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Style="{StaticResource TextDisplay}" Text="StartupPilot"/>
                <TextBlock Style="{StaticResource TextCaption}" Margin="0,4,0,0"
                           Text="Inspect and control everything Windows runs at sign-in. Drop a program or shortcut anywhere on this page to add it to your Startup folder."/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                <Border Style="{StaticResource Pill}" Margin="0,0,12,0"
                        Visibility="{Binding IsAdmin, Converter={StaticResource InverseBoolToVis}}"
                        ToolTip="Machine-wide entries (HKLM, all-users startup folder, scheduled tasks and services) can only be changed when PowerDesk runs elevated.">
                    <TextBlock Text="Not elevated: machine-wide items are read-only" Foreground="{DynamicResource WarningBrush}" FontSize="12"/>
                </Border>
                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,12,0"
                           Text="{Binding LastScan, StringFormat='Last scan: {0:HH:mm:ss}', TargetNullValue='Not scanned yet'}"/>
                <Button Content="Add to startup…" Margin="0,0,8,0" Command="{Binding AddStartupEntryCommand}"
                        ToolTip="Pick a program or shortcut to launch at sign-in. A shortcut is placed in your Startup folder (or drop files onto this page)."/>
                <Button Content="Rescan" Style="{StaticResource PrimaryButton}" Command="{Binding RescanCommand}"
                        ToolTip="Scan registry Run keys, startup folders, scheduled tasks and services again (F5)."/>
                <Button Content="Relaunch as administrator" Margin="8,0,0,0"
                        Command="{Binding RelaunchAsAdminCommand}"
                        ToolTip="Restart PowerDesk elevated so machine-wide startup items can be changed."
                        Visibility="{Binding IsAdmin, Converter={StaticResource InverseBoolToVis}}"/>
            </StackPanel>
        </DockPanel>

        <!-- Busy indicator -->
        <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3" Margin="0,12,0,0" BorderThickness="0"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>

        <!-- Stat row + filters -->
        <Grid Grid.Row="2" Margin="0,12,0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Stat strip -->
            <WrapPanel Grid.Row="0">
                <Border Style="{StaticResource Card}" Margin="0,0,12,12" MinWidth="150" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="Startup entries" Style="{StaticResource TextCaption}"/>
                        <TextBlock Text="{Binding StartupEntryCount}" Style="{StaticResource TextTitle}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,12" MinWidth="150" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="Enabled" Style="{StaticResource TextCaption}"/>
                        <TextBlock Text="{Binding EnabledCount}" Style="{StaticResource TextTitle}" Foreground="{DynamicResource SuccessBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,12" MinWidth="150" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="Disabled" Style="{StaticResource TextCaption}"/>
                        <TextBlock Text="{Binding DisabledCount}" Style="{StaticResource TextTitle}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,12" MinWidth="150" Padding="16,12"
                        ToolTip="Entries whose target file no longer exists.">
                    <StackPanel>
                        <TextBlock Text="Orphaned" Style="{StaticResource TextCaption}"/>
                        <TextBlock Text="{Binding OrphanCount}" Style="{StaticResource TextTitle}" Foreground="{DynamicResource WarningBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,12" MinWidth="150" Padding="16,12"
                        ToolTip="Enabled entries whose executable is larger than 50 MB (a rough proxy for load cost).">
                    <StackPanel>
                        <TextBlock Text="High impact" Style="{StaticResource TextCaption}"/>
                        <TextBlock Text="{Binding HighImpactCount}" Style="{StaticResource TextTitle}" Foreground="{DynamicResource DangerBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,12" MinWidth="150" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="Services" Style="{StaticResource TextCaption}"/>
                        <TextBlock Text="{Binding ServiceCount}" Style="{StaticResource TextTitle}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,12" MinWidth="150" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="Automatic services" Style="{StaticResource TextCaption}"/>
                        <TextBlock Text="{Binding AutomaticServiceCount}" Style="{StaticResource TextTitle}" Foreground="{DynamicResource SuccessBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,12" MinWidth="150" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="Manual services" Style="{StaticResource TextCaption}"/>
                        <TextBlock Text="{Binding ManualServiceCount}" Style="{StaticResource TextTitle}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,12" MinWidth="150" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="Disabled services" Style="{StaticResource TextCaption}"/>
                        <TextBlock Text="{Binding DisabledServiceCount}" Style="{StaticResource TextTitle}" Foreground="{DynamicResource WarningBrush}"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- Filter row -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox Width="240" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Search by name, publisher, command line or service name."
                                 AutomationProperties.Name="Search startup items"/>
                        <CheckBox Content="Registry"       Margin="16,0,0,0" IsChecked="{Binding FilterRegistry}"       ToolTip="Show entries from the registry Run and RunOnce keys."/>
                        <CheckBox Content="Startup folder" Margin="16,0,0,0" IsChecked="{Binding FilterStartupFolder}"  ToolTip="Show entries from the per-user and all-users Startup folders."/>
                        <CheckBox Content="Tasks"          Margin="16,0,0,0" IsChecked="{Binding FilterTaskScheduler}"  ToolTip="Show scheduled tasks with a logon or boot trigger."/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox Width="120" SelectedValuePath="Tag" SelectedValue="{Binding StatusFilter}"
                                  ToolTip="Filter by enabled/disabled state." AutomationProperties.Name="Status filter">
                            <ComboBoxItem Content="All status"  Tag="{x:Static m:StartupStatusFilter.All}"/>
                            <ComboBoxItem Content="Enabled"     Tag="{x:Static m:StartupStatusFilter.Enabled}"/>
                            <ComboBoxItem Content="Disabled"    Tag="{x:Static m:StartupStatusFilter.Disabled}"/>
                        </ComboBox>
                        <ComboBox Width="120" Margin="8,0,0,0" SelectedValuePath="Tag" SelectedValue="{Binding ImpactFilter}"
                                  ToolTip="Filter by estimated impact." AutomationProperties.Name="Impact filter">
                            <ComboBoxItem Content="All impact" Tag="{x:Static m:StartupImpactFilter.All}"/>
                            <ComboBoxItem Content="High"       Tag="{x:Static m:StartupImpactFilter.High}"/>
                            <ComboBoxItem Content="Medium"     Tag="{x:Static m:StartupImpactFilter.Medium}"/>
                            <ComboBoxItem Content="Low"        Tag="{x:Static m:StartupImpactFilter.Low}"/>
                        </ComboBox>
                        <CheckBox Content="Microsoft" Margin="16,0,0,0" IsChecked="{Binding ShowMicrosoft}"
                                  ToolTip="Include Windows and Microsoft entries (triggers a rescan)."/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <TabControl Grid.Row="3" Padding="0">
            <TabItem Header="Startup entries">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="380"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                        <Grid>
                            <DataGrid x:Name="ItemsGrid"
                                      ItemsSource="{Binding ItemsView}"
                                      SelectedItem="{Binding SelectedItem}"
                                      SelectionMode="Extended"
                                      IsReadOnly="True"
                                      PreviewMouseRightButtonDown="DataGrid_PreviewMouseRightButtonDown">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Toggle enabled"     Click="ToggleMenu_Click"/>
                                        <MenuItem Header="Open file location" Click="OpenLocationMenu_Click"/>
                                        <MenuItem Header="Copy command line"  Click="CopyMenu_Click"/>
                                        <MenuItem Header="Edit note…"         Click="NoteMenu_Click"/>
                                        <MenuItem Header="Pin / unpin"        Click="PinMenu_Click"/>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="" Width="Auto" MinWidth="58">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding Enabled, Mode=OneWay}"
                                                          AutomationProperties.Name="Enabled at sign-in"
                                                          Click="EnableToggle_Click">
                                                    <CheckBox.Style>
                                                        <Style TargetType="CheckBox" BasedOn="{StaticResource ToggleSwitch}">
                                                            <Setter Property="ToolTip" Value="Enable or disable this entry at sign-in."/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding NeedsElevation}" Value="True">
                                                                    <Setter Property="IsEnabled" Value="False"/>
                                                                    <Setter Property="ToolTip" Value="Run PowerDesk as administrator to change this entry."/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </CheckBox.Style>
                                                </CheckBox>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Status"    Binding="{Binding StatusLabel}"   Width="90"/>
                                    <DataGridTemplateColumn Header="" Width="Auto" MinWidth="44">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Image Source="{Binding Icon}" Width="16" Height="16" Margin="10,0,0,0"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Name"      Binding="{Binding Name}"          Width="*"   MinWidth="120" ElementStyle="{StaticResource TrimCell}"/>
                                    <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}"     Width="160" ElementStyle="{StaticResource TrimCell}"/>
                                    <DataGridTextColumn Header="Source"    Binding="{Binding SourceLabel}"   Width="120"/>
                                    <DataGridTextColumn Header="Scope"     Binding="{Binding Scope}"         Width="140" ElementStyle="{StaticResource TrimCell}"/>
                                    <DataGridTemplateColumn Header="Impact" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource Pill}"
                                                        Background="{Binding Impact, Converter={StaticResource ImpactToSoftBrush}}">
                                                    <TextBlock Text="{Binding ImpactLabel}"
                                                               Foreground="{Binding Impact, Converter={StaticResource ImpactToBrush}}"
                                                               FontWeight="SemiBold"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="" Width="Auto" MinWidth="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Style="{StaticResource Pill}"
                                                            Background="{DynamicResource AccentSoftBrush}"
                                                            Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="Pinned" Foreground="{DynamicResource AccentBrush}" FontSize="11"/>
                                                    </Border>
                                                    <Border Style="{StaticResource Pill}" Margin="6,0,0,0"
                                                            Background="{DynamicResource SurfaceActiveBrush}"
                                                            ToolTip="The target file could not be found."
                                                            Visibility="{Binding IsOrphaned, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="Orphan" Foreground="{DynamicResource WarningBrush}" FontSize="11"/>
                                                    </Border>
                                                    <Border Style="{StaticResource Pill}" Margin="6,0,0,0"
                                                            Background="{DynamicResource SurfaceActiveBrush}"
                                                            ToolTip="Changing this entry requires running PowerDesk as administrator."
                                                            Visibility="{Binding NeedsElevation, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="Admin" Foreground="{DynamicResource WarningBrush}" FontSize="11"/>
                                                    </Border>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Empty state -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                        Visibility="{Binding ItemsView.IsEmpty, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="No startup entries to show" Style="{StaticResource TextSubtitle}"
                                           HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="Run a scan, loosen the search and filters above, or drop a program here to add it to startup."
                                           Style="{StaticResource TextCaption}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Margin="16,0,0,0">
                        <TabControl>
                            <TabItem Header="Details">
                                <Grid Margin="0,12,0,0">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Visibility="{Binding SelectedItem, Converter={StaticResource NullToVis}, ConverterParameter=invert}">
                                        <TextBlock Text="No item selected" Style="{StaticResource TextSubtitle}"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Text="Pick a row in the table to see details."
                                                   Style="{StaticResource TextCaption}"
                                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    </StackPanel>

                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  Visibility="{Binding SelectedItem, Converter={StaticResource NullToVis}}">
                                        <StackPanel DataContext="{Binding SelectedItem}">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource TextSubtitle}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding StatusLabel}" Foreground="{DynamicResource AccentBrush}" FontSize="12"/>
                                            <TextBlock Text="{Binding Publisher}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                                            <Border Style="{StaticResource Pill}" Margin="0,8,0,0"
                                                    Background="{DynamicResource SurfaceActiveBrush}"
                                                    Visibility="{Binding NeedsElevation, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Requires administrator to change" Foreground="{DynamicResource WarningBrush}" FontSize="11"/>
                                            </Border>
                                            <Border Background="{DynamicResource DividerBrush}" Height="1" Margin="0,12"/>
                                            <StackPanel>
                                                <TextBlock Text="Command line" Style="{StaticResource TextCaption}"/>
                                                <TextBlock Text="{Binding CommandLine}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"/>
                                                <TextBlock Text="Target" Style="{StaticResource TextCaption}" Margin="0,10,0,0"/>
                                                <TextBlock Text="{Binding TargetPath}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"/>
                                                <TextBlock Text="Description" Style="{StaticResource TextCaption}" Margin="0,10,0,0"/>
                                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                                                <TextBlock Text="Scope" Style="{StaticResource TextCaption}" Margin="0,10,0,0"/>
                                                <TextBlock Text="{Binding Scope}"/>
                                                <TextBlock Text="Note" Style="{StaticResource TextCaption}" Margin="0,10,0,0"
                                                           Visibility="{Binding Note, Converter={StaticResource NullToVis}}"/>
                                                <TextBlock Text="{Binding Note}" TextWrapping="Wrap"
                                                           Visibility="{Binding Note, Converter={StaticResource NullToVis}}"/>
                                            </StackPanel>
                                            <Border Background="{DynamicResource DividerBrush}" Height="1" Margin="0,12"/>
                                            <WrapPanel>
                                                <Button Content="Open location" Click="OpenLocationMenu_Click" Margin="0,0,8,8"
                                                        ToolTip="Show the target file in Explorer."/>
                                                <Button Content="Copy command" Click="CopyMenu_Click" Margin="0,0,8,8"
                                                        ToolTip="Copy the command line to the clipboard."/>
                                                <Button Content="Edit note…" Click="NoteMenu_Click" Margin="0,0,8,8"
                                                        ToolTip="Attach a private note to this entry."/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </TabItem>

                            <TabItem Header="History">
                                <Grid Margin="0,12,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBox Grid.Row="0" Text="{Binding HistorySearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
                                             ToolTip="Filter history by item name or source." AutomationProperties.Name="Search history"/>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                                        <Button Content="Undo last" Style="{StaticResource PrimaryButton}" Command="{Binding UndoLastCommand}"
                                                ToolTip="Revert the most recent change."/>
                                        <Button Content="Export CSV" Margin="8,0,0,0" Command="{Binding ExportHistoryCsvCommand}"
                                                ToolTip="Save the change history as a CSV file."/>
                                    </StackPanel>
                                    <Grid Grid.Row="2">
                                        <DataGrid ItemsSource="{Binding HistoryView}" IsReadOnly="True" SelectionMode="Single">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="When"   Binding="{Binding TimestampDisplay}" Width="140"/>
                                                <DataGridTextColumn Header="Item"   Binding="{Binding ItemName}"         Width="*" MinWidth="80" ElementStyle="{StaticResource TrimCell}"/>
                                                <DataGridTextColumn Header="Action" Binding="{Binding Action}"           Width="Auto" MinWidth="80"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <TextBlock Text="No changes recorded yet." Style="{StaticResource TextCaption}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                                   Visibility="{Binding HistoryView.IsEmpty, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </Grid>
                            </TabItem>

                            <TabItem Header="Bulk">
                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock Style="{StaticResource TextSubtitle}" Text="Bulk actions"/>
                                    <TextBlock Style="{StaticResource TextCaption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                               Text="Select one or more rows in the table (Ctrl/Shift+click), then apply. Services are changed one at a time from the Services tab."/>
                                    <Button Content="Enable selected"  Margin="0,12,0,0" Click="BulkEnable_Click"
                                            ToolTip="Enable every selected startup entry."/>
                                    <Button Content="Disable selected" Style="{StaticResource DangerButton}" Margin="0,8,0,0" Click="BulkDisable_Click"
                                            ToolTip="Disable every selected startup entry."/>
                                    <Border Background="{DynamicResource DividerBrush}" Height="1" Margin="0,16"/>
                                    <CheckBox Content="Confirm before disable" IsChecked="{Binding ConfirmBeforeDisable}"
                                              ToolTip="Ask before disabling an entry or a service."/>
                                    <TextBlock Text="History retention" Style="{StaticResource TextCaption}" Margin="0,12,0,4"/>
                                    <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding Retention}" AutomationProperties.Name="History retention">
                                        <ComboBoxItem Content="Keep all"      Tag="{x:Static m:HistoryRetention.KeepAll}"/>
                                        <ComboBoxItem Content="Last 100"      Tag="{x:Static m:HistoryRetention.Last100}"/>
                                        <ComboBoxItem Content="Last 30 days"  Tag="{x:Static m:HistoryRetention.Last30Days}"/>
                                    </ComboBox>
                                </StackPanel>
                            </TabItem>
                        </TabControl>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Services">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="380"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                        <Grid>
                            <DataGrid x:Name="ServicesGrid"
                                      ItemsSource="{Binding ServicesView}"
                                      SelectedItem="{Binding SelectedService}"
                                      SelectionMode="Single"
                                      IsReadOnly="True"
                                      PreviewMouseRightButtonDown="DataGrid_PreviewMouseRightButtonDown">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Set Automatic" Click="ServiceAutomaticMenu_Click"/>
                                        <MenuItem Header="Set Manual"    Click="ServiceManualMenu_Click"/>
                                        <MenuItem Header="Set Disabled"  Click="ServiceDisabledMenu_Click"/>
                                        <Separator/>
                                        <MenuItem Header="Open file location" Click="ServiceOpenLocationMenu_Click"/>
                                        <MenuItem Header="Copy command line"  Click="ServiceCopyMenu_Click"/>
                                        <MenuItem Header="Edit note…"         Click="ServiceNoteMenu_Click"/>
                                        <MenuItem Header="Pin / unpin"        Click="ServicePinMenu_Click"/>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Startup type" Binding="{Binding StartupTypeLabel}" Width="110"/>
                                    <DataGridTemplateColumn Header="" Width="Auto" MinWidth="44">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Image Source="{Binding Icon}" Width="16" Height="16" Margin="10,0,0,0"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Name"         Binding="{Binding Name}"       Width="*"   MinWidth="140" ElementStyle="{StaticResource TrimCell}"/>
                                    <DataGridTextColumn Header="Service name" Binding="{Binding Locator}"    Width="160" ElementStyle="{StaticResource TrimCell}"/>
                                    <DataGridTextColumn Header="Publisher"    Binding="{Binding Publisher}"  Width="160" ElementStyle="{StaticResource TrimCell}"/>
                                    <DataGridTextColumn Header="Target"       Binding="{Binding TargetPath}" Width="220" ElementStyle="{StaticResource MonoCell}"/>
                                    <DataGridTemplateColumn Header="" Width="Auto" MinWidth="60">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource Pill}"
                                                        Background="{DynamicResource AccentSoftBrush}"
                                                        Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="Pinned" Foreground="{DynamicResource AccentBrush}" FontSize="11"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                        Visibility="{Binding ServicesView.IsEmpty, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="No services to show" Style="{StaticResource TextSubtitle}"
                                           HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="Run a scan, clear the search, or enable Microsoft items to see Windows services."
                                           Style="{StaticResource TextCaption}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Margin="16,0,0,0">
                        <Grid Margin="0,12,0,0">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding SelectedService, Converter={StaticResource NullToVis}, ConverterParameter=invert}">
                                <TextBlock Text="No service selected" Style="{StaticResource TextSubtitle}"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="Pick a service to view or change its startup type."
                                           Style="{StaticResource TextCaption}"
                                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>

                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          Visibility="{Binding SelectedService, Converter={StaticResource NullToVis}}">
                                <StackPanel DataContext="{Binding SelectedService}">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource TextSubtitle}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding StartupTypeLabel}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Locator}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                    <Border Style="{StaticResource Pill}" Margin="0,8,0,0"
                                            Background="{DynamicResource SurfaceActiveBrush}"
                                            Visibility="{Binding NeedsElevation, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Requires administrator to change" Foreground="{DynamicResource WarningBrush}" FontSize="11"/>
                                    </Border>
                                    <Border Background="{DynamicResource DividerBrush}" Height="1" Margin="0,12"/>

                                    <TextBlock Text="Startup type" Style="{StaticResource TextCaption}"/>
                                    <UniformGrid Columns="3" Margin="0,8,0,0">
                                        <Button Content="Automatic"
                                                Margin="0,0,6,0"
                                                ToolTip="Start the service when Windows starts."
                                                Command="{Binding DataContext.SetSelectedServiceAutomaticCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                        <Button Content="Manual"
                                                Margin="3,0,3,0"
                                                ToolTip="Start the service only when something requests it."
                                                Command="{Binding DataContext.SetSelectedServiceManualCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                        <Button Content="Disabled"
                                                Margin="6,0,0,0"
                                                Style="{StaticResource DangerButton}"
                                                ToolTip="Prevent the service from starting at all."
                                                Command="{Binding DataContext.SetSelectedServiceDisabledCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </UniformGrid>

                                    <Border Background="{DynamicResource DividerBrush}" Height="1" Margin="0,14"/>
                                    <TextBlock Text="Command line" Style="{StaticResource TextCaption}"/>
                                    <TextBlock Text="{Binding CommandLine}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"/>
                                    <TextBlock Text="Description" Style="{StaticResource TextCaption}" Margin="0,10,0,0"/>
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                                    <TextBlock Text="Publisher" Style="{StaticResource TextCaption}" Margin="0,10,0,0"/>
                                    <TextBlock Text="{Binding Publisher}" TextWrapping="Wrap"/>
                                    <TextBlock Text="Note" Style="{StaticResource TextCaption}" Margin="0,10,0,0"
                                               Visibility="{Binding Note, Converter={StaticResource NullToVis}}"/>
                                    <TextBlock Text="{Binding Note}" TextWrapping="Wrap"
                                               Visibility="{Binding Note, Converter={StaticResource NullToVis}}"/>

                                    <Border Background="{DynamicResource DividerBrush}" Height="1" Margin="0,12"/>
                                    <WrapPanel>
                                        <Button Content="Open location" Click="ServiceOpenLocationMenu_Click" Margin="0,0,8,8"
                                                ToolTip="Show the service executable in Explorer."/>
                                        <Button Content="Copy command" Click="ServiceCopyMenu_Click" Margin="0,0,8,8"
                                                ToolTip="Copy the service command line to the clipboard."/>
                                        <Button Content="Edit note…" Click="ServiceNoteMenu_Click" Margin="0,0,8,8"
                                                ToolTip="Attach a private note to this service."/>
                                    </WrapPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
